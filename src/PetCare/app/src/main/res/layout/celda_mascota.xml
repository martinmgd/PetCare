<?xml version="1.0" encoding="utf-8"?>

<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="110dp"
    android:layout_marginTop="8dp"
    android:layout_marginBottom="8dp"
    app:cardBackgroundColor="#F2EAFB"
    app:cardCornerRadius="18dp"
    app:cardElevation="2dp"
    app:strokeColor="#E0D2F3"
    app:strokeWidth="1dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="16dp">

        <ImageView
            android:id="@+id/ivMascota"
            android:layout_width="58dp"
            android:layout_height="58dp"
            android:src="@drawable/ic_launcher_foreground"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/txtNombreMascota"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="18dp"
            android:layout_marginEnd="8dp"
            android:text="Pancho"
            android:textColor="#333333"
            android:textSize="20sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@id/txtFlechaMascota"
            app:layout_constraintStart_toEndOf="@id/ivMascota"
            app:layout_constraintTop_toTopOf="@id/ivMascota" />

        <TextView
            android:id="@+id/txtDatosMascota"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="18dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="8dp"
            android:text="Perro - Setter - 10 anos"
            android:textColor="#666666"
            android:textSize="15sp"
            app:layout_constraintEnd_toStartOf="@id/txtFlechaMascota"
            app:layout_constraintStart_toEndOf="@id/ivMascota"
            app:layout_constraintTop_toBottomOf="@id/txtNombreMascota" />

        <TextView
            android:id="@+id/txtFlechaMascota"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="›"
            android:textColor="#777777"
            android:textSize="34sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>